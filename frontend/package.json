{
  "name": "resume-ai-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src vite.config.ts index.html",
    "test": "node --experimental-transform-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.69.0",
    "@tiptap/extension-color": "^2.27.3",
    "@tiptap/extension-text-style": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@tiptap/vue-3": "^2.27.3",
    "docx": "^9.15.2",
    "dompurify": "^3.4.17",
    "element-plus": "^2.14.7",
    "gsap": "^3.15.1",
    "vanilla-tilt": "1.8.1",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
